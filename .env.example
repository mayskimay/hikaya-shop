# Vorlage für Umgebungsvariablen. KEINE echten Werte in diese Datei schreiben!
# Echte Werte gehören zu Vercel (Settings → Environment Variables) oder lokal in
# eine Datei ".env.local" (wird von Git ignoriert).

# --- Shop-Adresse (für Links in E-Mails und Rücksprung von Stripe) ---
NEXT_PUBLIC_SITE_URL=https://hikaya-shop.vercel.app

# --- Sanity (CMS) ---
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Token mit Schreibrecht ("Editor"), nur für den Server: speichert Bestellungen, bucht Bestand ab
SANITY_API_WRITE_TOKEN=

# --- Stripe (Zahlung) ---
# Testmodus: sk_test_…   Live: sk_live_… (wird nur angenommen, wenn STRIPE_ALLOW_LIVE=true)
STRIPE_SECRET_KEY=
# Signing secret des Webhooks (whsec_…), Endpunkt: /api/stripe/webhook
STRIPE_WEBHOOK_SECRET=
# Erst auf "true" setzen, wenn Konto, Rechtstexte und ein Live-Test geprüft sind
STRIPE_ALLOW_LIVE=false

# --- Bestell-E-Mails (Resend) ---
RESEND_API_KEY=
# Absender, Domain muss bei Resend bestätigt sein, z. B.: Hikaya <bestellung@hikaya.at>
ORDER_EMAIL_FROM=
# Hierhin gehen Benachrichtigungen über neue Bestellungen (Inhaberin)
ORDER_NOTIFY_EMAIL=

# --- Versand-Seite für die Inhaberin (/admin/versand) ---
ADMIN_USER=
# mindestens 12 Zeichen, nirgends sonst verwenden
ADMIN_PASSWORD=

# --- DHL Express (MyDHL API) – Etiketten & Sendungsnummern ---
# Zugangsdaten aus dem DHL Developer Portal (developer.dhl.com), nach Freischaltung durch DHL
DHL_EXPRESS_API_USER=
DHL_EXPRESS_API_PASSWORD=
# DHL-Express-Kundennummer (Konto für den Versand)
DHL_EXPRESS_ACCOUNT_NUMBER=
# test = DHL-Testumgebung (Etiketten NICHT gültig), live = echte Sendungen
DHL_EXPRESS_MODE=test
# Erst auf "true" setzen, wenn DHL die Produktion freigegeben hat und ein Test erfolgreich war
DHL_ALLOW_LIVE=false

# --- DHL Sendungsverfolgung (Shipment Tracking – Unified API, kostenlos) ---
DHL_TRACKING_API_KEY=
# Schutz für die tägliche Status-Abfrage (beliebige lange Zeichenfolge)
CRON_SECRET=
